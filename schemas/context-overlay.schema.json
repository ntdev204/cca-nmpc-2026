{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-overlay.schema.json",
  "title": "Current human-context overlay for Internet-image diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "records"],
  "properties": {
    "schema": {"const": "cca-context-overlay-v1"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "finite_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "position_xy",
        "heading_unit",
        "speed_mps",
        "direction",
        "confidence",
        "context_valid",
        "timestamp_ns",
        "frame_id",
        "track_id",
        "coordinate_units",
        "source_sha256",
        "model_sha256"
      ],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "position_xy": {"$ref": "#/$defs/finite_pair"},
        "heading_unit": {"$ref": "#/$defs/finite_pair"},
        "speed_mps": {"type": "number", "minimum": 0},
        "direction": {"enum": ["left", "right", "forward", "backward", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "context_valid": {"type": "boolean"},
        "timestamp_ns": {"type": "integer", "minimum": 0},
        "frame_id": {"type": "string", "minLength": 1},
        "track_id": {"type": "integer", "minimum": 0},
        "coordinate_units": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
