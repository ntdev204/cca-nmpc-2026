{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physical-experiment-config.schema.json",
  "title": "CCA-NMPC position-state physical experiment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_mode",
    "state_definition",
    "physical_experiment_id",
    "experiment_id",
    "study_phase",
    "status",
    "stage",
    "frozen_at",
    "focused_audit",
    "protocol_freeze",
    "stage_gate",
    "ethics",
    "consent",
    "safety",
    "stop_rules",
    "target_hardware",
    "ground_truth",
    "trial_design",
    "evaluation_config",
    "environment_manifest",
    "output_run_manifest_root",
    "final_data_package"
  ],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "control_mode": {"const": "position_state"},
    "state_definition": {
      "const": ["x_m", "y_m", "theta_rad", "vx_mps", "vy_mps", "omega_radps"]
    },
    "physical_experiment_id": {
      "type": ["string", "null"],
      "pattern": "^phys-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "experiment_id": {
      "type": ["string", "null"],
      "pattern": "^exp-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "study_phase": {"enum": ["development", "pilot", "confirmatory"]},
    "status": {"enum": ["planned", "frozen", "running", "completed", "invalidated"]},
    "stage": {"enum": ["H0", "H1", "H2", "H3"]},
    "frozen_at": {"type": ["string", "null"], "format": "date-time"},
    "focused_audit": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
    "protocol_freeze": {"oneOf": [{"$ref": "#/$defs/protocol_freeze"}, {"type": "null"}]},
    "stage_gate": {"$ref": "#/$defs/stage_gate"},
    "ethics": {"$ref": "#/$defs/ethics"},
    "consent": {"$ref": "#/$defs/consent"},
    "safety": {"$ref": "#/$defs/safety"},
    "stop_rules": {"$ref": "#/$defs/stop_rules"},
    "target_hardware": {"$ref": "#/$defs/target_hardware"},
    "ground_truth": {"$ref": "#/$defs/ground_truth"},
    "trial_design": {"$ref": "#/$defs/trial_design"},
    "evaluation_config": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
    "environment_manifest": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
    "output_run_manifest_root": {
      "type": ["string", "null"],
      "allOf": [
        {
          "if": {"type": "string"},
          "then": {"$ref": "#/$defs/relative_path"},
          "else": {"type": "null"}
        }
      ]
    },
    "final_data_package": {"$ref": "#/$defs/final_data_package"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {"enum": ["H2", "H3"]},
          "status": {"enum": ["frozen", "running", "completed"]}
        },
        "required": ["stage", "status"]
      },
      "then": {
        "properties": {
          "ethics": {
            "properties": {"status": {"enum": ["approved", "exempt"]}}
          },
          "consent": {
            "properties": {
              "required": {"const": true},
              "status": {"const": "participant_complete"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {"enum": ["H0", "H1"]},
          "status": {"enum": ["frozen", "running", "completed"]}
        },
        "required": ["stage", "status"]
      },
      "then": {
        "properties": {
          "ethics": {"properties": {"status": {"const": "not_required"}}},
          "consent": {
            "properties": {
              "required": {"const": false},
              "status": {"const": "not_required"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["frozen", "running", "completed"]}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "physical_experiment_id": {"type": "string"},
          "experiment_id": {"type": "string"},
          "frozen_at": {"type": "string", "format": "date-time"},
          "protocol_freeze": {"$ref": "#/$defs/protocol_freeze"},
          "stage_gate": {
            "properties": {
              "status": {"const": "approved"},
              "record": {"$ref": "#/$defs/file_ref"}
            }
          },
          "safety": {
            "properties": {
              "plan": {"$ref": "#/$defs/file_ref"},
              "approved": {"const": true},
              "approved_by": {"type": "string", "minLength": 1},
              "approved_at": {"type": "string", "format": "date-time"},
              "independent_safety_operator_assigned": {"const": true},
              "emergency_stop_verified": {"const": true},
              "remote_disable_verified": {"const": true},
              "watchdog_verified": {"const": true},
              "speed_limit_mps": {"type": "number", "exclusiveMinimum": 0},
              "acceleration_limit_mps2": {"type": "number", "exclusiveMinimum": 0},
              "minimum_separation_m": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "stop_rules": {
            "properties": {
              "frozen": {"const": true},
              "record": {"$ref": "#/$defs/file_ref"}
            }
          },
          "target_hardware": {
            "properties": {
              "manifest": {"$ref": "#/$defs/file_ref"},
              "deadline_seconds": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "ground_truth": {
            "properties": {
              "system": {"type": "string", "minLength": 1},
              "calibration_record": {"$ref": "#/$defs/file_ref"},
              "uncertainty_record": {"$ref": "#/$defs/file_ref"}
            }
          },
          "trial_design": {
            "properties": {
              "scenarios": {"minItems": 1},
              "expected_trial_count": {"type": "integer", "minimum": 1},
              "attrition_policy": {"type": "string", "minLength": 1}
            }
          },
          "evaluation_config": {"$ref": "#/$defs/file_ref"},
          "environment_manifest": {"$ref": "#/$defs/file_ref"},
          "output_run_manifest_root": {"$ref": "#/$defs/relative_path"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "study_phase": {"const": "confirmatory"},
          "status": {"enum": ["frozen", "running", "completed"]}
        },
        "required": ["study_phase", "status"]
      },
      "then": {"properties": {"focused_audit": {"$ref": "#/$defs/file_ref"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"not": {"pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"}},
        {"not": {"pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)"}}
      ]
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocol_freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "protocol_ids", "revision", "freeze_record", "frozen_by", "frozen_at"],
      "properties": {
        "status": {"const": "FROZEN"},
        "protocol_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PR[0-9]{2}$"}
        },
        "revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "freeze_record": {"$ref": "#/$defs/file_ref"},
        "frozen_by": {"type": "string", "minLength": 1},
        "frozen_at": {"type": "string", "format": "date-time"}
      }
    },
    "stage_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "record"],
      "properties": {
        "status": {"enum": ["pending", "approved", "failed"]},
        "record": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]}
      }
    },
    "ethics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "record", "authority", "reviewed_at"],
      "properties": {
        "status": {"enum": ["pending", "not_required", "approved", "exempt"]},
        "record": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
        "authority": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["approved", "exempt"]}}, "required": ["status"]},
          "then": {
            "properties": {
              "record": {"$ref": "#/$defs/file_ref"},
              "authority": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      ]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "template", "participant_ledger", "privacy_retention_plan"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["pending", "not_required", "template_approved", "participant_complete"]},
        "template": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
        "participant_ledger": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
        "privacy_retention_plan": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}, "required": ["required"]},
          "then": {
            "properties": {
              "status": {"const": "participant_complete"},
              "template": {"$ref": "#/$defs/file_ref"},
              "participant_ledger": {"$ref": "#/$defs/file_ref"},
              "privacy_retention_plan": {"$ref": "#/$defs/file_ref"}
            }
          },
          "else": {"properties": {"status": {"const": "not_required"}}}
        }
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "approved",
        "approved_by",
        "approved_at",
        "independent_safety_operator_assigned",
        "emergency_stop_verified",
        "remote_disable_verified",
        "watchdog_verified",
        "speed_limit_mps",
        "acceleration_limit_mps2",
        "minimum_separation_m"
      ],
      "properties": {
        "plan": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
        "approved": {"type": "boolean"},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "independent_safety_operator_assigned": {"type": "boolean"},
        "emergency_stop_verified": {"type": "boolean"},
        "remote_disable_verified": {"type": "boolean"},
        "watchdog_verified": {"type": "boolean"},
        "speed_limit_mps": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "acceleration_limit_mps2": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "minimum_separation_m": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "stop_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen", "record", "conditions"],
      "properties": {
        "frozen": {"type": "boolean"},
        "record": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "contact_or_serious_near_contact",
              "localization_loss",
              "sensor_stale",
              "actuator_anomaly",
              "emergency_stop_failure",
              "operator_stop",
              "deadline_or_fallback_limit"
            ]
          },
          "allOf": [
            {"contains": {"const": "contact_or_serious_near_contact"}},
            {"contains": {"const": "localization_loss"}},
            {"contains": {"const": "sensor_stale"}},
            {"contains": {"const": "actuator_anomaly"}},
            {"contains": {"const": "emergency_stop_failure"}},
            {"contains": {"const": "operator_stop"}},
            {"contains": {"const": "deadline_or_fallback_limit"}}
          ]
        }
      }
    },
    "target_hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "timing_scope", "deadline_seconds"],
      "properties": {
        "manifest": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
        "timing_scope": {"const": "target_hardware"},
        "deadline_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "calibration_record", "uncertainty_record", "independent_from_estimator_under_test"],
      "properties": {
        "system": {"type": ["string", "null"]},
        "calibration_record": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
        "uncertainty_record": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
        "independent_from_estimator_under_test": {"const": true}
      }
    },
    "trial_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarios", "paired_controller_order", "randomized", "expected_trial_count", "attrition_policy"],
      "properties": {
        "scenarios": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "paired_controller_order": {"type": "boolean"},
        "randomized": {"type": "boolean"},
        "expected_trial_count": {"type": ["integer", "null"], "minimum": 1},
        "attrition_policy": {"type": ["string", "null"]}
      }
    },
    "final_data_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "root",
        "robot_state_csv",
        "control_csv",
        "context_csv",
        "events_csv",
        "map_json",
        "map_yaml",
        "map_image",
        "manifest_json",
        "checksum_file",
        "frame_id",
        "clock",
        "units",
        "context_only",
        "human_trajectory_generated"
      ],
      "properties": {
        "status": {"enum": ["planned", "captured", "verified", "invalidated"]},
        "root": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "robot_state_csv": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "control_csv": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "context_csv": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "events_csv": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "map_json": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "map_yaml": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "map_image": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "manifest_json": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "checksum_file": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "frame_id": {"type": ["string", "null"]},
        "clock": {"enum": ["robot_time", "system_time", null]},
        "units": {"const": "si"},
        "context_only": {"const": true},
        "human_trajectory_generated": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"enum": ["captured", "verified"]}},
            "required": ["status"]
          },
          "then": {
            "required": ["root", "robot_state_csv", "control_csv", "context_csv", "events_csv", "map_json", "manifest_json", "checksum_file", "frame_id", "clock"]
          }
        }
      ]
    }
  }
}
