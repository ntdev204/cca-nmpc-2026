{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-heading-observation.schema.json",
  "title": "Short-history human heading observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp_ns",
    "frame_id",
    "track_id",
    "position_xy",
    "heading_unit",
    "speed_per_s",
    "heading_valid",
    "confidence",
    "sample_count",
    "coordinate_units",
    "source_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "timestamp_ns": {"type": "integer", "minimum": 0},
    "frame_id": {"type": "string", "minLength": 1},
    "track_id": {"type": "integer", "minimum": 0},
    "position_xy": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "heading_unit": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "speed_per_s": {"type": "number", "minimum": 0},
    "heading_valid": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sample_count": {"type": "integer", "minimum": 1},
    "coordinate_units": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
  }
}
