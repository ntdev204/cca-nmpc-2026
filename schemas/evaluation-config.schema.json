{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-config.schema.json",
  "title": "CCA-NMPC evaluation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "status",
    "frozen_before_first_confirmatory_run",
    "frozen_at",
    "focused_audit",
    "protocol_freeze",
    "common",
    "statistics",
    "person_detection",
    "lstm_context",
    "cca_nmpc_control",
    "qualitative_evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "evaluation_id": {"type": ["string", "null"], "pattern": "^eval-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"enum": ["planned", "frozen", "executed", "verified", "invalidated"]},
    "frozen_before_first_confirmatory_run": {"type": "boolean"},
    "frozen_at": {"type": ["string", "null"], "format": "date-time"},
    "focused_audit": {"oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
    "protocol_freeze": {"oneOf": [{"$ref": "#/$defs/protocol_freeze"}, {"type": "null"}]},
    "common": {"$ref": "#/$defs/common"},
    "statistics": {"$ref": "#/$defs/statistics"},
    "person_detection": {"$ref": "#/$defs/person_detection"},
    "lstm_context": {"$ref": "#/$defs/lstm_context"},
    "cca_nmpc_control": {"$ref": "#/$defs/control_evaluation"},
    "qualitative_evidence": {"$ref": "#/$defs/qualitative_evidence"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["frozen", "executed", "verified"]}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evaluation_id": {"type": "string"},
          "frozen_before_first_confirmatory_run": {"const": true},
          "frozen_at": {"type": "string", "format": "date-time"},
          "focused_audit": {"$ref": "#/$defs/file_ref"},
          "protocol_freeze": {"$ref": "#/$defs/protocol_freeze"},
          "common": {
            "properties": {
              "primary_hypotheses": {"minItems": 1},
              "primary_metrics": {"minItems": 1},
              "baselines": {"minItems": 1},
              "random_seeds": {"minItems": 1},
              "failure_definition": {"type": "string", "minLength": 1},
              "missing_run_policy": {"type": "string", "minLength": 1},
              "outlier_policy": {"type": "string", "minLength": 1}
            }
          },
          "statistics": {
            "properties": {
              "power_or_sample_size_rationale": {"type": "string", "minLength": 1},
              "confidence_interval_method": {"type": "string", "minLength": 1},
              "hypothesis_tests": {"minItems": 1},
              "multiple_comparison_correction": {"type": "string", "minLength": 1},
              "effect_sizes": {"minItems": 1}
            }
          },
          "qualitative_evidence": {
            "properties": {"selection_rule_frozen_before_results": {"const": true}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"not": {"pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"}},
        {"not": {"pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)"}}
      ]
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocol_freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "protocol_ids", "revision", "freeze_record", "frozen_by", "frozen_at"],
      "properties": {
        "status": {"const": "FROZEN"},
        "protocol_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PR[0-9]{2}$"}
        },
        "revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "freeze_record": {"$ref": "#/$defs/file_ref"},
        "frozen_by": {"type": "string", "minLength": 1},
        "frozen_at": {"type": "string", "format": "date-time"}
      }
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_hypotheses",
        "primary_metrics",
        "secondary_metrics",
        "acceptance_thresholds",
        "baselines",
        "ablations",
        "random_seeds",
        "failure_definition",
        "missing_run_policy",
        "outlier_policy",
        "all_started_runs_in_denominator"
      ],
      "properties": {
        "primary_hypotheses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "primary_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "secondary_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "acceptance_thresholds": {"type": "object"},
        "baselines": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ablations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "random_seeds": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "failure_definition": {"type": ["string", "null"]},
        "missing_run_policy": {"type": ["string", "null"]},
        "outlier_policy": {"type": ["string", "null"]},
        "all_started_runs_in_denominator": {"const": true}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "power_or_sample_size_rationale",
        "paired_design",
        "confidence_level",
        "confidence_interval_method",
        "hypothesis_tests",
        "multiple_comparison_correction",
        "effect_sizes",
        "report_individual_runs"
      ],
      "properties": {
        "power_or_sample_size_rationale": {"type": ["string", "null"]},
        "paired_design": {"const": true},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "confidence_interval_method": {"type": ["string", "null"]},
        "hypothesis_tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "multiple_comparison_correction": {"type": ["string", "null"]},
        "effect_sizes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "report_individual_runs": {"const": true}
      }
    },
    "classification_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_kind",
        "ontology",
        "class_order",
        "decision_rule",
        "ground_truth",
        "genuine_negative_examples",
        "counts_rates_and_support_required"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_kind": {
          "enum": [
            "image_level_presence_classification",
            "multiclass_classification",
            "auxiliary_behavior_classification"
          ]
        },
        "ontology": {"$ref": "#/$defs/file_ref"},
        "class_order": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision_rule": {"$ref": "#/$defs/file_ref"},
        "ground_truth": {"$ref": "#/$defs/file_ref"},
        "genuine_negative_examples": {"const": true},
        "counts_rates_and_support_required": {"const": true}
      }
    },
    "optional_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "confusion_matrix_required"],
      "properties": {
        "enabled": {"type": ["boolean", "null"]},
        "confusion_matrix_required": {"type": "boolean"},
        "contract": {"$ref": "#/$defs/classification_contract"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"confusion_matrix_required": {"const": true}},
            "required": ["confusion_matrix_required"]
          },
          "then": {
            "required": ["contract"],
            "properties": {"enabled": {"const": true}}
          }
        },
        {
          "if": {"properties": {"enabled": {"const": false}}, "required": ["enabled"]},
          "then": {"properties": {"confusion_matrix_required": {"const": false}}}
        }
      ]
    },
    "person_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "test_source_must_be_internet_or_public_real_images",
        "generated_test_images_allowed",
        "bbox_detection_confusion_matrix_required",
        "iou_matching_threshold",
        "confidence_threshold",
        "metrics",
        "image_level_presence_classification",
        "subgroup_analysis_fields",
        "qualitative_failure_categories"
      ],
      "properties": {
        "enabled": {"type": ["boolean", "null"]},
        "test_source_must_be_internet_or_public_real_images": {"const": true},
        "generated_test_images_allowed": {"const": false},
        "bbox_detection_confusion_matrix_required": {"const": false},
        "iou_matching_threshold": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
        "confidence_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "image_level_presence_classification": {"$ref": "#/$defs/optional_classification"},
        "subgroup_analysis_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "qualitative_failure_categories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {
            "properties": {
              "iou_matching_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
              "subgroup_analysis_fields": {"minItems": 1},
              "qualitative_failure_categories": {"minItems": 1}
            }
          }
        }
      ]
    },
    "lstm_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "metrics",
        "baselines",
        "direction_classification",
        "context_overlay_required",
        "overlay_layers",
        "representative_case_selection_rule",
        "failure_case_selection_rule"
      ],
      "properties": {
        "enabled": {"type": ["boolean", "null"]},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "baselines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "direction_classification": {"$ref": "#/$defs/optional_classification"},
        "context_overlay_required": {"const": true},
        "overlay_layers": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "representative_case_selection_rule": {"type": ["string", "null"]},
        "failure_case_selection_rule": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {
            "properties": {
              "representative_case_selection_rule": {"type": "string", "minLength": 1},
              "failure_case_selection_rule": {"type": "string", "minLength": 1},
              "direction_classification": {
                "properties": {
                  "enabled": {"const": true},
                  "confusion_matrix_required": {"const": true}
                },
                "required": ["enabled", "confusion_matrix_required", "contract"]
              }
            }
          }
        }
      ]
    },
    "control_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "metrics",
        "paired_scenarios_and_seeds",
        "report_safety_separately_from_tracking_stability",
        "report_all_fallbacks_and_failed_runs"
      ],
      "properties": {
        "enabled": {"type": ["boolean", "null"]},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "paired_scenarios_and_seeds": {"const": true},
        "report_safety_separately_from_tracking_stability": {"const": true},
        "report_all_fallbacks_and_failed_runs": {"const": true}
      }
    },
    "qualitative_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "selection_rule_frozen_before_results",
        "include_first_eligible",
        "include_random_stratified",
        "include_median",
        "include_typical_failures",
        "include_worst_cases",
        "include_each_ood_stratum",
        "no_cherry_picked_only_figures"
      ],
      "properties": {
        "required": {"const": true},
        "selection_rule_frozen_before_results": {"type": "boolean"},
        "include_first_eligible": {"const": true},
        "include_random_stratified": {"const": true},
        "include_median": {"const": true},
        "include_typical_failures": {"const": true},
        "include_worst_cases": {"const": true},
        "include_each_ood_stratum": {"const": true},
        "no_cherry_picked_only_figures": {"const": true}
      }
    }
  }
}
