{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zotero-source-manifest.schema.json",
  "title": "Zotero source PDF provenance manifest",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "$ref": "#/$defs/source_record"
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)"
          }
        }
      ]
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "citation_number",
        "title",
        "doi",
        "in_main_tex",
        "mentioned_in_research_md",
        "source_files",
        "source_url",
        "retrieved_at",
        "sha256",
        "provenance_status",
        "metadata_files",
        "errors"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]+$"
        },
        "citation_number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[^/\\s]+/\\S+$"
        },
        "in_main_tex": {
          "type": "boolean"
        },
        "mentioned_in_research_md": {
          "type": "boolean"
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relative_path"
          }
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance_status": {
          "enum": [
            "verified-download",
            "legacy-origin-unresolved"
          ]
        },
        "metadata_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relative_path"
          }
        },
        "errors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance_status": {
                "const": "verified-download"
              }
            },
            "required": [
              "provenance_status"
            ]
          },
          "then": {
            "properties": {
              "source_url": {
                "type": "string",
                "minLength": 1,
                "format": "uri",
                "pattern": "^https://"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance_status": {
                "const": "legacy-origin-unresolved"
              }
            },
            "required": [
              "provenance_status"
            ]
          },
          "then": {
            "properties": {
              "source_url": {
                "const": null
              },
              "retrieved_at": {
                "const": null
              },
              "errors": {
                "contains": {
                  "const": "PDF-ORIGIN-UNRESOLVED"
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        }
      ]
    }
  }
}
