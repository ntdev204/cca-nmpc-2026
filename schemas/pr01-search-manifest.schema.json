{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr01-search-manifest.schema.json",
  "title": "Frozen PR01 systematic-search plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "protocol_id",
    "status",
    "frozen_at_utc",
    "frozen_by",
    "protocol_source",
    "coverage",
    "screening",
    "filter_profiles",
    "databases",
    "queries",
    "snowballing",
    "preexecution_amendment"
  ],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "manifest_id": {"const": "pr01-search-v3"},
    "protocol_id": {"const": "PR01"},
    "status": {"const": "FROZEN"},
    "frozen_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "frozen_by": {"$ref": "#/$defs/slug"},
    "protocol_source": {"$ref": "#/$defs/file_ref"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_year_start",
        "publication_year_end",
        "search_cutoff_date",
        "languages",
        "document_types",
        "older_classics_policy",
        "rationale"
      ],
      "properties": {
        "publication_year_start": {"const": 2010},
        "publication_year_end": {"const": 2026},
        "search_cutoff_date": {"const": "2026-08-01"},
        "languages": {
          "type": "array",
          "prefixItems": [{"const": "English"}],
          "items": false
        },
        "document_types": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["journal-article", "conference-paper", "review"]}
        },
        "older_classics_policy": {
          "const": "backward-snowballing-with-recorded-rationale"
        },
        "rationale": {"type": "string", "minLength": 40}
      }
    },
    "screening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_ids",
        "mode",
        "blinded_rescreen_fraction",
        "sampling",
        "conflict_resolution"
      ],
      "properties": {
        "reviewer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slug"}
        },
        "mode": {"enum": ["dual-independent", "single-blinded-rescreen"]},
        "blinded_rescreen_fraction": {"type": "number", "minimum": 0.2, "maximum": 1},
        "sampling": {"const": "stratified-by-database-and-decision"},
        "conflict_resolution": {"type": "string", "minLength": 20}
      }
    },
    "filter_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/filter_profile"}
    },
    "databases": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/database"}
    },
    "queries": {
      "type": "array",
      "minItems": 30,
      "items": {"$ref": "#/$defs/query"}
    },
    "snowballing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "google_scholar_role",
        "backward_rounds",
        "forward_rounds",
        "stopping_rule"
      ],
      "properties": {
        "google_scholar_role": {"const": "snowballing-only"},
        "backward_rounds": {"type": "integer", "minimum": 2},
        "forward_rounds": {"type": "integer", "minimum": 2},
        "stopping_rule": {"type": "string", "minLength": 20}
      }
    },
    "preexecution_amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amendment_id",
        "amended_at_utc",
        "superseded_manifest_sha256",
        "reason",
        "official_query_executions_before_amendment"
      ],
      "properties": {
        "amendment_id": {"const": "pr01-search-retrieval-amendment-02"},
        "amended_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "superseded_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 40},
        "official_query_executions_before_amendment": {"const": 0}
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"not": {"pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"}},
        {"not": {"pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)"}}
      ]
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "filter_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filter_profile_id",
        "publication_year_start",
        "publication_year_end",
        "search_cutoff_date",
        "languages",
        "document_types"
      ],
      "properties": {
        "filter_profile_id": {"$ref": "#/$defs/slug"},
        "publication_year_start": {"const": 2010},
        "publication_year_end": {"const": 2026},
        "search_cutoff_date": {"const": "2026-08-01"},
        "languages": {
          "type": "array",
          "prefixItems": [{"const": "English"}],
          "items": false
        },
        "document_types": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["journal-article", "conference-paper", "review"]}
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_id",
        "database_name",
        "coverage_role",
        "interface",
        "platform_url",
        "documentation_url",
        "export_tool",
        "access_state_at_freeze",
        "access_note",
        "required_for_completion",
        "retrieval_policy"
      ],
      "properties": {
        "database_id": {"$ref": "#/$defs/slug"},
        "database_name": {"type": "string", "minLength": 2},
        "coverage_role": {"enum": ["core-bibliographic", "broad-robotics-control"]},
        "interface": {"enum": ["web-ui", "rest-api"]},
        "platform_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "documentation_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "export_tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 2},
            "version": {"type": "string", "minLength": 2}
          }
        },
        "access_state_at_freeze": {
          "enum": [
            "accessible",
            "preview-only",
            "login-required",
            "api-accessible",
            "access-blocked"
          ]
        },
        "access_note": {"type": "string", "minLength": 15},
        "required_for_completion": {"type": "boolean"},
        "retrieval_policy": {
          "oneOf": [
            {"$ref": "#/$defs/ranked_cap_policy"},
            {"$ref": "#/$defs/all_results_policy"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"database_id": {"const": "crossref"}},
            "required": ["database_id"]
          },
          "then": {
            "properties": {
              "retrieval_policy": {
                "required": ["cap_records_per_query"],
                "properties": {
                  "mode": {"const": "ranked-cap"},
                  "cap_records_per_query": {"const": 1000},
                  "page_size": {"const": 1000},
                  "ordering": {"const": "score:desc"},
                  "pagination_method": {"const": "none"},
                  "reported_total_semantics": {
                    "const": "source-reported-unverified"
                  },
                  "completion_rule": {"const": "cap-reached-or-source-exhausted"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"database_id": {"const": "semantic-scholar"}},
            "required": ["database_id"]
          },
          "then": {
            "properties": {
              "retrieval_policy": {
                "required": ["platform_record_limit", "overflow_action"],
                "properties": {
                  "mode": {"const": "all-results-pagination"},
                  "page_size": {"const": 1000},
                  "ordering": {"const": "paperId:asc"},
                  "pagination_method": {"const": "continuation-token"},
                  "reported_total_semantics": {"const": "estimated"},
                  "completion_rule": {"const": "terminal-pagination-state"},
                  "platform_record_limit": {"const": 10000000},
                  "overflow_action": {"const": "fail-and-amend"}
                }
              }
            }
          }
        }
      ]
    },
    "ranked_cap_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "cap_records_per_query",
        "page_size",
        "ordering",
        "pagination_method",
        "reported_total_semantics",
        "completion_rule",
        "scope_statement"
      ],
      "properties": {
        "mode": {"const": "ranked-cap"},
        "cap_records_per_query": {"type": "integer", "minimum": 1},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 1000},
        "ordering": {"type": "string", "minLength": 3},
        "pagination_method": {"enum": ["none", "cursor", "offset"]},
        "reported_total_semantics": {
          "enum": ["exact", "estimated", "source-reported-unverified"]
        },
        "completion_rule": {"const": "cap-reached-or-source-exhausted"},
        "scope_statement": {"type": "string", "minLength": 30}
      }
    },
    "all_results_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "page_size",
        "ordering",
        "pagination_method",
        "reported_total_semantics",
        "completion_rule",
        "platform_record_limit",
        "overflow_action",
        "scope_statement"
      ],
      "properties": {
        "mode": {"const": "all-results-pagination"},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 1000},
        "ordering": {"type": "string", "minLength": 3},
        "pagination_method": {
          "enum": ["continuation-token", "cursor", "ui-batch"]
        },
        "reported_total_semantics": {
          "enum": ["exact", "estimated", "source-reported-unverified"]
        },
        "completion_rule": {"const": "terminal-pagination-state"},
        "platform_record_limit": {"type": ["integer", "null"], "minimum": 1},
        "overflow_action": {"const": "fail-and-amend"},
        "scope_statement": {"type": "string", "minLength": 30}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "database_id",
        "concept_block",
        "lrq_ids",
        "search_fields",
        "exact_query",
        "filter_profile_id",
        "platform_filters",
        "export_format"
      ],
      "properties": {
        "query_id": {"type": "string", "pattern": "^qry-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "database_id": {"$ref": "#/$defs/slug"},
        "concept_block": {
          "enum": [
            "context-human-nmpc",
            "chance-risk-human",
            "adaptive-risk",
            "elastic-chance",
            "lstm-trajectory",
            "mecanum-dynamics"
          ]
        },
        "lrq_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^LRQ-0[1-7]$"}
        },
        "search_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exact_query": {"type": "string", "minLength": 20},
        "filter_profile_id": {"$ref": "#/$defs/slug"},
        "platform_filters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "export_format": {"enum": ["ris", "csv", "json", "plain-text"]}
      }
    }
  }
}
