{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol-freeze-manifest.schema.json",
  "title": "CCA-NMPC protocol freeze manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "freeze_id",
    "freeze_version",
    "profile",
    "status",
    "created_at",
    "created_by",
    "code_revision",
    "dirty_worktree",
    "protocols",
    "claim_ids",
    "research_gap_gate",
    "holdout_access",
    "amendments",
    "deviations"
  ],
  "properties": {
  "schema_version": {"const": "1.3.0"},
    "freeze_id": {
      "type": "string",
      "pattern": "^freeze-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "freeze_version": {"$ref": "#/$defs/semver"},
    "profile": {"enum": ["comprehensive_q1", "amended_scope"]},
    "status": {"const": "FROZEN"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "pattern": "^[A-Fa-f0-9]{40,64}$"},
    "dirty_worktree": {"const": false},
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/protocol"}
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CLM-(?:NOV|EMP|T|ML|SIM|HW)-[0-9]{2,}$"
      }
    },
    "research_gap_gate": {"$ref": "#/$defs/research_gap_gate"},
    "holdout_access": {"$ref": "#/$defs/holdout_access"},
    "amendments": {
      "type": "array",
      "items": {"$ref": "#/$defs/amendment"}
    },
    "deviations": {
      "type": "array",
      "items": {"$ref": "#/$defs/deviation"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"profile": {"const": "comprehensive_q1"}},
        "required": ["profile"]
      },
      "then": {
        "properties": {
          "protocols": {
            "minItems": 10,
            "maxItems": 10,
            "allOf": [
              {"contains": {"properties": {"protocol_id": {"const": "PR00"}}, "required": ["protocol_id"]}, "minContains": 1},
              {"contains": {"properties": {"protocol_id": {"const": "PR02"}}, "required": ["protocol_id"]}, "minContains": 1},
              {"contains": {"properties": {"protocol_id": {"const": "PR10"}}, "required": ["protocol_id"]}, "minContains": 1},
              {"contains": {"properties": {"protocol_id": {"const": "PR11"}}, "required": ["protocol_id"]}, "minContains": 1},
              {"contains": {"properties": {"protocol_id": {"const": "PR12"}}, "required": ["protocol_id"]}, "minContains": 1},
              {"contains": {"properties": {"protocol_id": {"const": "PR20"}}, "required": ["protocol_id"]}, "minContains": 1},
              {"contains": {"properties": {"protocol_id": {"const": "PR21"}}, "required": ["protocol_id"]}, "minContains": 1},
              {"contains": {"properties": {"protocol_id": {"const": "PR30"}}, "required": ["protocol_id"]}, "minContains": 1},
              {"contains": {"properties": {"protocol_id": {"const": "PR40"}}, "required": ["protocol_id"]}, "minContains": 1},
              {"contains": {"properties": {"protocol_id": {"const": "PR50"}}, "required": ["protocol_id"]}, "minContains": 1}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"not": {"pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"}},
        {"not": {"pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)"}}
      ]
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "role", "decision", "reviewed_at"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["scientific", "statistics", "ethics_privacy", "safety", "principal_investigator"]},
        "decision": {"const": "approved"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    },
    "research_gap_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_id",
        "status",
        "audit_record",
        "zotero_export",
        "nearest_work_matrix",
        "reviewer_id",
        "reviewer_role",
        "reviewed_at",
        "rationale"
      ],
      "properties": {
        "audit_id": {"pattern": "^audit-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "status": {"const": "COMPLETE"},
        "audit_record": {"$ref": "#/$defs/file_ref"},
        "zotero_export": {"$ref": "#/$defs/file_ref"},
        "nearest_work_matrix": {"$ref": "#/$defs/file_ref"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewer_role": {"enum": ["scientific", "principal_investigator"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "version",
        "status",
        "source",
        "frozen_at",
        "approvals",
        "primary_outcomes",
        "stopping_rules"
      ],
      "properties": {
        "protocol_id": {
          "type": "string",
          "pattern": "^PR(?:00|01|02|10|11|12|20|21|30|40|50)$"
        },
        "version": {"$ref": "#/$defs/semver"},
        "status": {"const": "FROZEN"},
        "source": {"$ref": "#/$defs/file_ref"},
        "frozen_at": {"type": "string", "format": "date-time"},
        "approvals": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/approval"}
        },
        "primary_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "stopping_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "holdout_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "accessed_before_freeze", "attestation"],
      "properties": {
        "state": {"const": "sealed"},
        "accessed_before_freeze": {"const": false},
        "attestation": {"type": "string", "minLength": 1},
        "access_control_record": {"$ref": "#/$defs/file_ref"}
      }
    },
    "amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amendment_id",
        "protocol_id",
        "reason",
        "created_at",
        "data_seen",
        "confirmatory_impact",
        "approved_by"
      ],
      "properties": {
        "amendment_id": {"type": "string", "pattern": "^AMD-[0-9]{2,}$"},
        "protocol_id": {
          "type": "string",
          "pattern": "^PR(?:00|01|02|10|11|12|20|21|30|40|50)$"
        },
        "reason": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "data_seen": {"type": "string", "minLength": 1},
        "confirmatory_impact": {"enum": ["none", "new_confirmatory_version_required", "exploratory_only"]},
        "approved_by": {"type": "string", "minLength": 1},
        "record": {"$ref": "#/$defs/file_ref"}
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviation_id", "protocol_id", "description", "impact", "recorded_at"],
      "properties": {
        "deviation_id": {"type": "string", "pattern": "^DEV-[0-9]{2,}$"},
        "protocol_id": {
          "type": "string",
          "pattern": "^PR(?:00|01|02|10|11|12|20|21|30|40|50)$"
        },
        "description": {"type": "string", "minLength": 1},
        "impact": {"enum": ["none", "exploratory_only", "invalidates_confirmatory_run"]},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
