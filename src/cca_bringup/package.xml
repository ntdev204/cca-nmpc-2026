<?xml version="1.0"?>
<package format="3">
  <name>cca_bringup</name>
  <version>0.1.0</version>
  <description>Bringup for CCA-NMPC, SLAM, Nav2 and optional sensor drivers.</description>
  <maintainer email="thientn204@users.noreply.github.com">Nguyen Ngoc Thien</maintainer>
  <license>Proprietary research code</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>cca_hardware</exec_depend>
  <exec_depend>cca_runtime</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>astra_camera</exec_depend>
  <exec_depend>lslidar_driver</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
